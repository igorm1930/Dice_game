# pnpm keeps a symlinked store by default, which breaks `COPY --from=deps node_modules`
# in a Docker image. The API image must therefore build its runtime tree with
# `pnpm deploy --filter=@dice-game/api --prod`, which materialises a real directory.
# See AGENTS.md → "Docker and pnpm".
strict-peer-dependencies=false
auto-install-peers=true
engine-strict=true
