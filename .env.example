# Copy to .env for local development. Contains no secrets — every value here is
# a port, a bound, a duration, or a local connection string.
#
# Production secrets (MONGODB_URI, JWT_SECRET, CORS_ORIGIN, FLY_API_TOKEN,
# NEXT_PUBLIC_API_URL) are set in the Fly and Vercel dashboards and are never
# committed. See docs/deployment.md.

# ---- Runtime ----
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ---- Database ----
# Local MongoDB comes up with `docker compose up -d`.
MONGODB_URI=mongodb://localhost:27017/dice-game
MONGODB_DB_NAME=dice-game

# ---- Authentication ----
# Development-only value. Production MUST set a distinct high-entropy secret;
# the API refuses to boot in production if this value is still the default.
JWT_SECRET=dev-only-not-a-secret-change-me-in-production
# Access-token lifetime. Short by design: tokens live in sessionStorage, so the
# blast radius of a stolen one is bounded by this window.
JWT_EXPIRES_IN=15m
# Argon2id cost. Raise `ARGON2_MEMORY_KIB` before raising time cost.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---- HTTP ----
# Comma-separated allowlist. Production must name the Vercel origin explicitly;
# "*" is a development convenience and the API rejects it when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000
BODY_LIMIT=16kb
# Proxy hops to trust when resolving the client IP. Must match the real topology:
# 0 locally, 1 behind Fly's proxy. Too high and a client forges X-Forwarded-For
# to mint a fresh rate-limit key per request; too low and every request keys on
# the load balancer.
TRUST_PROXY_HOPS=0

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Credential endpoints get their own, far smaller budget: a limit sized for
# gameplay is a limit sized for thousands of password guesses an hour.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- Lifecycle ----
# Grace period for in-flight requests during the SIGTERM drain. Fly's
# kill_timeout must exceed this or the process is SIGKILLed mid-drain.
SHUTDOWN_TIMEOUT_MS=10000

# ---- Observability ----
LOG_LEVEL=debug
# Pretty-print logs (development only). Production stays false: collectors want NDJSON.
LOG_PRETTY=true
SERVICE_NAME=dice-game-api

# ---- Demo data ----
# Seeds two demo players so a reviewer can play immediately. Never enabled
# against a production database; `pnpm db:seed` refuses to run when
# NODE_ENV=production.
SEED_DEMO_USERS=false

# ---- Frontend ----
# Read at build time by Next.js. Points at the API origin.
NEXT_PUBLIC_API_URL=http://localhost:3001
