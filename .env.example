# ---- Runtime ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- Observability ----
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Pretty-print logs (dev only). Production MUST stay false: log collectors want NDJSON.
LOG_PRETTY=true
SERVICE_NAME=dice-game-service

# ---- HTTP ----
# Comma-separated allowlist, or "*" for any origin.
CORS_ORIGIN=*
BODY_LIMIT=16kb
# Number of proxy hops to trust for client IP resolution (0 disables).
# Must be >0 behind a load balancer or rate limiting keys on the LB's IP.
TRUST_PROXY_HOPS=0

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Lifecycle ----
# Grace period for in-flight requests during SIGTERM drain.
SHUTDOWN_TIMEOUT_MS=10000

# ---- Game rules ----
GAME_DEFAULT_ROUNDS=5
GAME_MAX_ROUNDS=20
# Pig game: default target when NEW GAME does not name one (players may pick
# their own per game, 2-1000).
PIG_TARGET_SCORE=100

# ---- Authentication ----
# Credential endpoints (/auth/register, /auth/login) get their own, far smaller
# budget than gameplay: a limit sized for dice is sized for password guessing.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Session lifetime (12h). Sessions live in process memory, so a restart already
# invalidates every credential — see docs/adr/0007.
AUTH_TOKEN_TTL_MS=43200000
