# Production deployment — copy to `.env.production` and fill in.
#
#   cp .env.production.example .env.production
#   docker compose -f compose.prod.yaml --env-file .env.production up -d --build
#
# `.env.production` is gitignored. Nothing in this file is a working value; the
# compose file uses `${VAR:?message}` so a missing one fails the command with
# the name of what is missing rather than starting something half-configured.

# The domain pointing at this host. Its A/AAAA record must already resolve here
# before the first `up`, because Let's Encrypt validates over HTTP on port 80
# and a failed issuance counts against a rate limit of five per week.
DOMAIN=dice.example.com

# Where Let's Encrypt sends expiry warnings. A real address you read.
ACME_EMAIL=you@example.com

# MongoDB's root credentials. The database publishes no port and is reachable
# only from the compose network, but these are still real credentials for real
# accounts — generate, do not invent:
#
#   openssl rand -base64 32
MONGO_USERNAME=dice
MONGO_PASSWORD=

# Signs every access token. Forging one is forging any player's identity, so
# this is the single most sensitive value here.
#
#   openssl rand -base64 48
#
# The API refuses to boot in production if this is left at the development
# default from .env.example — see apps/api/src/config/env.schema.ts.
JWT_SECRET=

# Stamped into the health endpoint and the image label, so a running deployment
# can be matched to a commit.
APP_VERSION=2.0.0
GIT_SHA=
